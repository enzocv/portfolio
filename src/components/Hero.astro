---
import { Image } from 'astro:assets';
import Scene from './Scene.astro';
import perfil from '../assets/perfil.png';
import { BOOT_SCRIPT } from '../data/scripts';
import { renderTyped } from '../features/scroll/shared/typewriter';
import { BOOT_MIN_CHARS } from '../features/scroll/scenes/BootScene';

// Primer frame de la terminal renderizado en el servidor (sin parpadeo al cargar).
const firstFrame = renderTyped(BOOT_SCRIPT, BOOT_MIN_CHARS);
---

<Scene name="boot" anchor="top" label="Portada" length="300vh">
	<div class="boot">
		<div class="term" data-boot-term aria-hidden="true">
			<div class="term-bar"><i></i><i></i><i></i><span>zsh · ~/enzo</span></div>
			<pre class="term-body"><span data-boot-text set:html={firstFrame} /><span class="cursor"></span></pre>
		</div>

		<div class="hero" data-boot-hero>
			<Image
				src={perfil}
				alt="Enzo Catalán"
				class="photo"
				widths={[420, 640, 900]}
				sizes="(max-width: 760px) 80vw, 40vw"
				format="webp"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="hero-content wrap" data-boot-content>
				<p class="eyebrow status"><span class="dot"></span>Tacna, Perú · Disponible para proyectos</p>
				<h1 class="name" data-boot-name><span>Enzo</span><span>Catalán</span></h1>
				<p class="role">Full Stack Developer. Construyo web, apps móviles y APIs con arquitectura limpia.</p>
				<div class="ctas">
					<a href="#work" class="btn btn-solid">Ver proyectos</a>
					<a href="#contact" class="btn btn-ghost">Contactarme</a>
				</div>
			</div>
		</div>
	</div>
</Scene>

<script>
	import { mountScenes } from '../features/scroll';
	import { BootScene } from '../features/scroll/scenes/BootScene';
	import { BOOT_SCRIPT } from '../data/scripts';

	mountScenes('boot', (root) => new BootScene(root, BOOT_SCRIPT));
</script>

<style>
	.boot { position: relative; height: 100%; min-height: 100svh; background: #070b10; }

	/* Terminal (solo existe en el modo animado). */
	.term {
		display: none;
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(680px, calc(100% - 32px));
		height: min(380px, 62%);
		transform: translate(-50%, -50%);
		background: #0e151d;
		border: 1px solid var(--color-line);
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
	}
	.term-bar {
		height: 38px;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 14px;
		border-bottom: 1px solid var(--color-line);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-muted);
	}
	.term-bar i { width: 11px; height: 11px; border-radius: 50%; background: var(--color-line); }
	.term-bar span { margin-inline: auto; transform: translateX(-24px); }
	.term-body {
		margin: 0;
		padding: 18px 20px;
		font-family: var(--font-mono);
		font-size: clamp(12px, 1.5vw, 14px);
		line-height: 1.75;
		color: #cfd6df;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.term-body :global(.pr) { color: var(--color-accent); }
	.term-body :global(.ok) { color: var(--color-ok); }
	.term-body :global(.dim) { color: var(--color-muted); }
	.term-body :global(.url) { color: var(--color-warm); }

	/* Portada. */
	.hero {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		background:
			radial-gradient(60% 70% at 78% 30%, rgb(138 151 255 / 0.35), transparent 70%),
			radial-gradient(50% 60% at 10% 90%, rgb(255 181 77 / 0.22), transparent 70%),
			#0d131b;
	}
	.photo {
		position: absolute;
		right: max(2vw, var(--gutter-r));
		bottom: 0;
		height: min(88%, 900px);
		width: auto;
		max-width: none;
		-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
		pointer-events: none;
		user-select: none;
	}
	.hero-content { position: relative; z-index: 1; width: 100%; padding-top: var(--nav-h); }
	.status { display: flex; align-items: center; gap: 10px; color: #c9ceff; }
	.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-ok); box-shadow: 0 0 12px var(--color-ok); }
	.name {
		--wdth: 128;
		display: flex;
		flex-direction: column;
		margin: 14px 0 18px;
		font-family: var(--font-display);
		font-weight: 850;
		font-size: clamp(54px, 13vw, 200px);
		line-height: 0.82;
		letter-spacing: -0.015em;
		font-variation-settings: "wdth" var(--wdth);
	}
	.name span:last-child { color: var(--color-warm); }
	.role { max-width: 36ch; font-size: clamp(16px, 2vw, 22px); color: var(--color-soft); }
	.ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

	/* Modo animado: la terminal se ve y la portada empieza cerrada. */
	:global(html.motion) .term { display: block; }
	:global(html.motion) .hero { clip-path: inset(50% 50% 50% 50%); }
	:global(html.motion) .hero-content { opacity: 0; }
	:global(html.motion) .name { --wdth: 55; }

	@media (max-width: 760px) {
		.hero { align-items: flex-end; padding-bottom: 8svh; }
		.photo { right: 50%; transform: translateX(50%); height: 74%; opacity: 0.55; }
		.name { --wdth: 100; }
	}
</style>
