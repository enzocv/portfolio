---
import { RESUMES } from '../data/social';

const navLinks = [
	{ href: '#about', label: 'Sobre mí' },
	{ href: '#tech', label: 'Stack' },
	{ href: '#work', label: 'Proyectos' },
	{ href: '#experience', label: 'Experiencia' },
	{ href: '#services', label: 'Servicios' },
	{ href: '#contact', label: 'Contacto' },
];
---

<header class="nav">
	<div class="bar">
		<a href="#top" class="logo">Enzo<span>Catalán</span></a>

		<nav class="links" aria-label="Secciones">
			{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<div class="cv" role="group" aria-label="Descargar CV">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" /></svg>
			<span>CV</span>
			{RESUMES.map((cv) => (
				<a href={cv.href} download={cv.file} aria-label={cv.label} lang={cv.lang.toLowerCase()}>{cv.lang}</a>
			))}
		</div>

		<button class="toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
			<span></span><span></span>
		</button>
	</div>

	<div class="menu" id="mobile-menu" data-menu>
		<div class="menu-inner">
			<nav aria-label="Secciones">
				{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>
			<div class="menu-cv">
				{RESUMES.map((cv, i) => (
					<a href={cv.href} download={cv.file} lang={cv.lang.toLowerCase()} class:list={['btn', i === 0 ? 'btn-solid' : 'btn-ghost']}>{cv.label}</a>
				))}
			</div>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	const setOpen = (open: boolean) => {
		menu?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
	};

	toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		padding-top: env(safe-area-inset-top, 0px);
		background: color-mix(in srgb, var(--color-ink) 72%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid color-mix(in srgb, var(--color-line) 60%, transparent);
	}
	.bar {
		max-width: 1120px;
		height: var(--nav-h);
		margin-inline: auto;
		padding-left: var(--gutter-l);
		padding-right: var(--gutter-r);
		display: flex;
		align-items: center;
		gap: 24px;
	}
	.logo {
		display: flex;
		gap: 6px;
		margin-right: auto;
		font-family: var(--font-display);
		font-size: 20px;
		font-weight: 800;
		font-variation-settings: "wdth" 85;
		color: var(--color-fg);
		text-decoration: none;
	}
	.logo span { color: var(--color-warm); }
	.links { display: flex; gap: 22px; }
	.links a, .menu nav a {
		color: var(--color-soft);
		font-size: 14px;
		text-decoration: none;
		transition: color 0.2s;
	}
	.links a:hover, .menu nav a:hover { color: var(--color-fg); }
	.cv {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 6px 4px 12px;
		border: 1px solid var(--color-line);
		border-radius: 999px;
		color: var(--color-fg);
		font-family: var(--font-mono);
		font-size: 13px;
		text-decoration: none;
		transition: border-color 0.2s, background-color 0.2s;
	}
	.cv:hover, .cv:focus-within { border-color: var(--color-warm); }
	.cv span { margin-right: 2px; color: var(--color-muted); }
	.cv a { padding: 3px 8px; border-radius: 999px; color: var(--color-fg); text-decoration: none; transition: background-color 0.2s, color 0.2s; }
	.cv a:hover { background: var(--color-warm); color: var(--color-ink); }
	.cv svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

	.toggle {
		display: none;
		width: 44px;
		height: 44px;
		margin-right: -10px;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 6px;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	.toggle span { width: 20px; height: 2px; background: var(--color-fg); transition: transform 0.25s; }
	.toggle[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
	.toggle[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }

	.menu { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
	.menu.is-open { grid-template-rows: 1fr; }
	.menu-inner { min-height: 0; overflow: hidden; padding-left: var(--gutter-l); padding-right: var(--gutter-r); }
	.menu nav { display: flex; flex-direction: column; border-top: 1px solid var(--color-line); }
	.menu nav a { padding: 12px 0; border-bottom: 1px solid color-mix(in srgb, var(--color-line) 50%, transparent); }
	.menu-cv { display: grid; gap: 8px; margin: 14px 0 16px; }
	.menu .btn { justify-content: center; width: 100%; }

	@media (min-width: 900px) {
		.menu { display: none; }
	}
	@media (max-width: 899px) {
		.links { display: none; }
		.cv { display: none; }
		.toggle { display: flex; }
	}
</style>
