---
import { withBase } from '../utils/paths';

interface Props {
	title: string;
	description?: string;
	/** Carga Material Symbols (solo lo usa la página de privacidad). */
	withIcons?: boolean;
}

const {
	title,
	description = 'Enzo Catalán, Full Stack Developer en Tacna, Perú. Web, apps móviles y APIs con arquitectura limpia.',
	withIcons = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="theme-color" content="#0b1016" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<title>{title}</title>
		<!-- Las escenas se animan solo si el usuario no pidió reducir el movimiento. -->
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('motion');
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@50..150,300..900&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		{withIcons && (
			<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
		)}
	</head>
	<body class="bg-ink text-fg font-body antialiased">
		<div class="scroll-progress" aria-hidden="true"></div>
		<slot />
	</body>
</html>

<style is:global>
	@import "tailwindcss";

	@theme {
		/* Paleta: tinta azulada, acento lavanda y un cálido ámbar para lo importante. */
		--color-ink: #0b1016;
		--color-ink-2: #121a23;
		--color-ink-3: #1a2430;
		--color-line: #263344;
		--color-fg: #e7ebf1;
		--color-soft: #c4ccd8;
		--color-muted: #8f9bab;
		--color-accent: #8a97ff;
		--color-warm: #ffb54d;
		--color-ok: #5fd6a0;
		--color-paper: #eef0f3;
		--color-paper-fg: #18202b;

		/* Alias heredados (los usa la página de privacidad). */
		--color-background: var(--color-ink);
		--color-surface: var(--color-ink);
		--color-surface-container-lowest: #0e141b;
		--color-surface-container-low: var(--color-ink-2);
		--color-surface-container: var(--color-ink-2);
		--color-surface-container-high: var(--color-ink-3);
		--color-surface-container-highest: #222e3c;
		--color-surface-bright: #2a3747;
		--color-on-surface: var(--color-fg);
		--color-on-surface-variant: #b3bdca;
		--color-outline: #5c6b7e;
		--color-outline-variant: var(--color-line);
		--color-primary: var(--color-accent);
		--color-primary-container: var(--color-accent);
		--color-on-primary-container: var(--color-ink);
		--color-secondary: var(--color-warm);
		--color-secondary-container: #4a3a1f;

		--spacing-xs: 0.5rem;
		--spacing-sm: 1rem;
		--spacing-md: 1.5rem;
		--spacing-lg: 2.5rem;
		--spacing-xl: 4rem;
		--spacing-gutter: 1.5rem;
		--spacing-margin: 2rem;

		--font-display: "Anybody", "Arial Narrow", system-ui, sans-serif;
		--font-body: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
		--font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
		/* Alias heredados. */
		--font-space: var(--font-display);
		--font-inter: var(--font-body);
	}

	@utility glass {
		background: color-mix(in srgb, var(--color-ink-2) 85%, transparent);
		backdrop-filter: blur(12px);
		border: 1px solid var(--color-line);
	}

	:root {
		--nav-h: 64px;
		--gutter-l: max(16px, env(safe-area-inset-left, 0px));
		--gutter-r: max(16px, env(safe-area-inset-right, 0px));
		color-scheme: dark;
	}

	html {
		background: var(--color-ink);
		scroll-behavior: smooth;
	}

	body {
		font-size: 16px;
		line-height: 1.6;
		overflow-x: clip;
	}

	h1, h2, h3 { text-wrap: balance; }

	a:focus-visible, button:focus-visible {
		outline: 2px solid var(--color-warm);
		outline-offset: 3px;
		border-radius: 4px;
	}

	@layer components {
		.wrap {
			max-width: 1120px;
			margin-inline: auto;
			padding-left: var(--gutter-l);
			padding-right: var(--gutter-r);
		}
		.eyebrow {
			font-family: var(--font-mono);
			font-size: 12px;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--color-muted);
		}
		.cursor {
			display: inline-block;
			width: 0.6em;
			height: 1.1em;
			vertical-align: -0.2em;
			background: var(--color-warm);
			animation: cursor-blink 1s steps(2) infinite;
		}
		.btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 12px 22px;
			border-radius: 999px;
			font-weight: 600;
			font-size: 15px;
			text-decoration: none;
			cursor: pointer;
			border: 1px solid transparent;
			transition: background-color 0.2s, border-color 0.2s, color 0.2s;
		}
		.btn-solid { background: var(--color-fg); color: var(--color-ink); }
		.btn-solid:hover { background: var(--color-warm); }
		.btn-ghost { border-color: var(--color-line); color: var(--color-fg); }
		.btn-ghost:hover { border-color: var(--color-accent); background: var(--color-ink-3); }
	}

	@keyframes cursor-blink { 50% { opacity: 0; } }

	/* Barra de progreso global con CSS scroll-driven (sin JS). */
	.scroll-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 60;
		background: linear-gradient(90deg, var(--color-accent), var(--color-warm));
		transform-origin: 0 50%;
		transform: scaleX(0);
		pointer-events: none;
	}
	@supports (animation-timeline: scroll()) {
		.scroll-progress {
			animation: scroll-progress-grow linear both;
			animation-timeline: scroll(root block);
		}
		@keyframes scroll-progress-grow { to { transform: scaleX(1); } }
	}

	::-webkit-scrollbar { width: 8px; }
	::-webkit-scrollbar-track { background: var(--color-ink); }
	::-webkit-scrollbar-thumb { background: var(--color-line); border-radius: 4px; }
	::-webkit-scrollbar-thumb:hover { background: var(--color-accent); }

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
